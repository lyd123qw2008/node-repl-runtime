{
  "name": "@lyd123qw2008/node-repl-runtime",
  "version": "0.1.1",
  "description": "node_repl-shaped runtime: a persistent JS kernel with any MCP server injected as a capability catalog",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "node-repl",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "capability-runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyd123qw2008/node-repl-runtime.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@qwen-code/node-repl-mcp": "0.1.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.20.0",
    "zod": "4.2.0"
  }
}

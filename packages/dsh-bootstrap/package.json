{
  "name": "@lyd123qw2008/node-repl-dsh-bootstrap",
  "version": "0.1.2",
  "description": "Mounts the node_repl runtime into a DSH profile from configuration alone",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "node-repl",
    "mcp",
    "dsh",
    "deepseek-harness",
    "profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyd123qw2008/node-repl-runtime.git",
    "directory": "packages/dsh-bootstrap"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@lyd123qw2008/node-repl-dsh-adapter": "workspace:*",
    "@lyd123qw2008/node-repl-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "vitest": "^4.1.8"
  }
}

{
  "name": "node-repl-runtime-windows-acl-phase0-verify",
  "private": true,
  "version": "0.0.0",
  "description": "Non-production Windows ACL Phase 0 verification harness; not a runtime package",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test ./tests/*.test.mjs",
    "verify:reference:unconfined-fd7": "node ./scripts/run-unconfined-fd7.mjs",
    "verify:reference:dsh-source-baseline": "node ./scripts/run-dsh-source-baseline.mjs",
    "verify:reference:ci-native-audit": "node ./native/verify-artifact.mjs",
    "verify:preflight": "node ./scripts/run-native-preflight.mjs",
    "verify:preflight:report": "node ./scripts/run-native-preflight.mjs --report-only",
    "verify:tier20:owned-worker": "node ./scripts/run-owned-worker-probe.mjs"
  },
  "dependencies": {
    "koffi": "3.1.1"
  }
}
